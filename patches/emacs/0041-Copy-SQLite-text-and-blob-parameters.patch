Subject: [PATCH] Copy SQLite text and blob parameters

SPDX-FileCopyrightText: 2026 Chen Zhexuan
SPDX-License-Identifier: GPL-3.0-or-later

Parameterized sqlite-select can return a statement before SQLite steps it.
GC can move Lisp string bytes in the meantime, even if the string itself
remains reachable. Have SQLite own copies of bound text and blob values
instead of lending it pointers into the Lisp heap.

--- a/src/sqlite.c
+++ b/src/sqlite.c
@@ -385,18 +385,19 @@
 						 Qnil, Qnil);
 	    }
 
+	  /* GC can move Lisp string data while the statement is live.  */
 	  if (blob)
 	    {
 	      if (SBYTES (value) != SCHARS (value))
 		xsignal1 (Qsqlite_error, build_string ("BLOB values must be unibyte"));
 	    ret = sqlite3_bind_blob (stmt, i + 1,
 				       SSDATA (value), SBYTES (value),
-				       NULL);
+				       SQLITE_TRANSIENT);
 	    }
 	    else
 	      ret = sqlite3_bind_text (stmt, i + 1,
 				       SSDATA (encoded), SBYTES (encoded),
-				       NULL);
+				       SQLITE_TRANSIENT);
 	}
       else if (FIXNUMP (value))
 	ret = sqlite3_bind_int64 (stmt, i + 1, XFIXNUM (value));
