 	    got_some_output = status_output;
 	  if (do_display)
 	    redisplay_preserve_echo_area (113);
+	  /* Filters, sentinels and redisplay can replace descriptors or
+	     recursively consume their data.  Poll again before using either
+	     readiness mask against the current descriptor owners.  */
+	  continue;
 	}
 #endif
 
