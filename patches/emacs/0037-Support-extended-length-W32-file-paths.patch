+#include <windows.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+#include <emacs-module.h>
+
+int plugin_is_GPL_compatible;
+
+static char *
+string_arg (emacs_env *env, emacs_value value)
+{
+  ptrdiff_t size = 0;
+  if (!env->copy_string_contents (env, value, NULL, &size))
+    return NULL;
+  char *text = malloc (size);
+  if (!text)
+    return NULL;
+  if (!env->copy_string_contents (env, value, text, &size))
+    {
+      free (text);
+      return NULL;
+    }
+  return text;
+}
+
+/* Deliberately independent of Emacs's filename conversion routines.  */
+static wchar_t *
+native_path (const char *text)
+{
+  int size = MultiByteToWideChar (CP_UTF8, MB_ERR_INVALID_CHARS,
+                                text, -1, NULL, 0);
+  if (!size)
+    return NULL;
+  wchar_t *raw = malloc (size * sizeof *raw);
+  if (!raw)
+    return NULL;
+  MultiByteToWideChar (CP_UTF8, MB_ERR_INVALID_CHARS, text, -1, raw, size);
+  for (wchar_t *p = raw; *p; p++)
+    if (*p == L'/')
+      *p = L'\\';
+  DWORD needed = GetFullPathNameW (raw, 0, NULL, NULL);
+  wchar_t *full = needed ? malloc (needed * sizeof *full) : NULL;
+  if (!full || !GetFullPathNameW (raw, needed, full, NULL))
+    {
+      free (raw);
+      free (full);
+      return NULL;
+    }
+  free (raw);
+  BOOL unc = full[0] == L'\\' && full[1] == L'\\';
+  wchar_t *result = malloc ((wcslen (full) + 9) * sizeof *result);
+  if (result)
+    {
+      wcscpy (result, unc ? L"\\\\?\\UNC\\" : L"\\\\?\\");
+      wcscat (result, full + (unc ? 2 : 0));
+    }
+  free (full);
+  return result;
+}
+
+static int
+write_fixture (wchar_t *path)
+{
+  /* Skip the drive root or UNC share when creating parent directories.  */
+  wchar_t *start = path + 7;
+  if (wcsncmp (path, L"\\\\?\\UNC\\", 8) == 0)
+    {
+      start = wcschr (path + 8, L'\\');
+      start = start ? wcschr (start + 1, L'\\') : NULL;
+      if (!start)
+        return -ERROR_INVALID_NAME;
+      start++;
+    }
+  for (wchar_t *p = start; *p; p++)
+    if (*p == L'\\')
+      {
+        *p = 0;
+        BOOL ok = CreateDirectoryW (path, NULL);
+        DWORD error = GetLastError ();
+        *p = L'\\';
+        if (!ok && error != ERROR_ALREADY_EXISTS)
+          return -(int) error;
+      }
+  HANDLE h = CreateFileW (path, GENERIC_WRITE,
+                         FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                         NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+  if (h == INVALID_HANDLE_VALUE)
+    return -(int) GetLastError ();
+  static const char contents[] = "long-path-probe!\n";
+  DWORD written = 0;
+  BOOL ok = WriteFile (h, contents, sizeof contents - 1, &written, NULL);
+  DWORD error = GetLastError ();
+  CloseHandle (h);
+  return ok ? (int) written : -(int) error;
+}
+
+/* Never follow a reparse point while cleaning a fixture tree.  */
+static BOOL
+remove_tree (const wchar_t *path)
+{
+  DWORD attrs = GetFileAttributesW (path);
+  if (attrs == INVALID_FILE_ATTRIBUTES)
+    return GetLastError () == ERROR_FILE_NOT_FOUND
+      || GetLastError () == ERROR_PATH_NOT_FOUND;
+  if (!(attrs & FILE_ATTRIBUTE_DIRECTORY))
+    {
+      SetFileAttributesW (path, FILE_ATTRIBUTE_NORMAL);
+      return DeleteFileW (path);
+    }
+  if (!(attrs & FILE_ATTRIBUTE_REPARSE_POINT))
+    {
+      size_t len = wcslen (path);
+      wchar_t *child = malloc ((len + MAX_PATH + 3) * sizeof *child);
+      if (!child)
+        return FALSE;
+      wcscpy (child, path);
+      wcscat (child, L"\\*");
+      WIN32_FIND_DATAW data;
+      HANDLE find = FindFirstFileW (child, &data);
+      if (find != INVALID_HANDLE_VALUE)
+        {
+          do
+            {
+              if (wcscmp (data.cFileName, L".") == 0
+                  || wcscmp (data.cFileName, L"..") == 0)
+                continue;
+              child[len] = L'\\';
+              wcscpy (child + len + 1, data.cFileName);
+              if (!remove_tree (child))
+                {
+                  FindClose (find);
+                  free (child);
+                  return FALSE;
+                }
+            }
+          while (FindNextFileW (find, &data));
+          FindClose (find);
+        }
+      free (child);
+    }
+  return RemoveDirectoryW (path);
+}
+
+static emacs_value
+probe (emacs_env *env, ptrdiff_t nargs, emacs_value *args, void *data)
+{
+  char *op = string_arg (env, args[0]);
+  char *text = string_arg (env, args[1]);
+  wchar_t *path = text ? native_path (text) : NULL;
+  intmax_t result = -ERROR_INVALID_PARAMETER;
+  if (op && path)
+    {
+      if (strcmp (op, "write") == 0)
+        result = write_fixture (path);
+      else if (strcmp (op, "units") == 0)
+        result = wcslen (path) - (wcsncmp (path, L"\\\\?\\UNC\\", 8) ? 4 : 6);
+      else if (strcmp (op, "remove") == 0
+               && strstr (text, "emacs-w32-long-path-") != NULL)
+        result = remove_tree (path) ? 0 : -(int) GetLastError ();
+      else if (strcmp (op, "size") == 0)
+        {
+          HANDLE h = CreateFileW (path, 0,
+                                 FILE_SHARE_READ | FILE_SHARE_WRITE
+                                 | FILE_SHARE_DELETE,
+                                 NULL, OPEN_EXISTING, 0, NULL);
+          LARGE_INTEGER size;
+          if (h == INVALID_HANDLE_VALUE)
+            result = -(int) GetLastError ();
+          else
+            {
+              result = GetFileSizeEx (h, &size) ? size.QuadPart
+                : -(int) GetLastError ();
+              CloseHandle (h);
+            }
+        }
+    }
+  free (path);
+  free (text);
+  free (op);
+  return env->make_integer (env, result);
+}
+
+int
+emacs_module_init (struct emacs_runtime *runtime)
+{
+  emacs_env *env = runtime->get_environment (runtime);
+  emacs_value args[] = {
+    env->intern (env, "w32-long-path-tests--native"),
+    env->make_function (env, 2, 2, probe,
+                        "Independent Win32 fixture: OP and absolute PATH.", NULL)
+  };
+  env->funcall (env, env->intern (env, "fset"), 2, args);
+  return 0;
+}
diff --git a/test/src/w32-long-path-tests.el b/test/src/w32-long-path-tests.el
