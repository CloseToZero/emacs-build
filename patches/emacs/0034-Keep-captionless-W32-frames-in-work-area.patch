+/* Return the outer rectangle that lets a captionless maximized window fill
+   the monitor work area without covering reserved UI such as the taskbar.  */
+static bool
+w32_maximized_work_area_rect (HWND hwnd, RECT *monitor_rect,
+                              RECT *window_rect)
+{
+  struct MONITOR_INFO monitor_info = { sizeof (monitor_info) };
+  WINDOWINFO window_info = { sizeof (window_info) };
+
+  if (!monitor_from_window_fn || !get_monitor_info_fn)
+    return false;
+
+  HMONITOR monitor =
+    monitor_from_window_fn (hwnd, MONITOR_DEFAULT_TO_NEAREST);
+  if (!get_monitor_info_fn (monitor, &monitor_info)
+      || !GetWindowInfo (hwnd, &window_info))
+    return false;
+
+  *monitor_rect = monitor_info.rcMonitor;
+  window_rect->left =
+    monitor_info.rcWork.left - window_info.cxWindowBorders;
+  window_rect->top =
+    monitor_info.rcWork.top - window_info.cyWindowBorders;
+  window_rect->right =
+    monitor_info.rcWork.right + window_info.cxWindowBorders;
+  window_rect->bottom =
+    monitor_info.rcWork.bottom + window_info.cyWindowBorders;
+  return true;
+}
