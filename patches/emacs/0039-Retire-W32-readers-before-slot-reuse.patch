 /* Shadow main io functions: we need to handle pipes and sockets more
    intelligently.  */
 
+/* Stop outstanding socket/serial I/O without reclaiming its handles.
+   The reader can still be returning through descriptor-table accesses.  */
+void
+w32_shutdown_reader (child_process *cp)
+{
+  int fd = cp->deferred_fd;
+  if (fd < 0)
+    return;
+  if (fd_info[fd].flags & FILE_SOCKET)
+    pfn_shutdown (SOCK_HANDLE (fd), 2);
+  else if (fd_info[fd].flags & FILE_SERIAL)
+    CancelIoEx (fd_info[fd].hnd, &cp->ovl_read);
+}
+
+/* Called by the main thread only after the reader has exited.  The CRT
+   descriptor remains allocated until here, so its table entry and socket
+   handle cannot have acquired another owner.  */
+void
+w32_reap_reader_fd (child_process *cp)
+{
+  int fd = cp->deferred_fd;
+  if (fd < 0)
+    return;
+  eassert (fd_info[fd].cp == NULL);
+  eassert (fd_info[fd].flags & FILE_DONT_CLOSE);
+  if (fd_info[fd].flags & FILE_SOCKET)
+    {
+      pfn_closesocket (SOCK_HANDLE (fd));
+      winsock_inuse--;
+    }
+  fd_info[fd].flags = 0;
+  _close (fd);
+  cp->deferred_fd = -1;
+}
