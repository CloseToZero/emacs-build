 static DWORD WINAPI reader_thread (void *arg);
 
+/* Reclaim reader resources only after the last use of its context and
+   events.  A pipe writer can outlive its process, so never wait here.  */
+static bool
+reap_child_reader (child_process *cp)
+{
+  if (cp->thrd)
+    {
+      DWORD result = WaitForSingleObject (cp->thrd, 0);
+      if (result == WAIT_TIMEOUT)
+	return false;
+      if (result != WAIT_OBJECT_0)
+	emacs_abort ();
+      CloseHandle (cp->thrd);
+      cp->thrd = NULL;
+    }
+  w32_reap_reader_fd (cp);
+  if (cp->char_avail)
+    {
+      CloseHandle (cp->char_avail);
+      cp->char_avail = NULL;
+    }
+  if (cp->char_consumed)
+    {
+      CloseHandle (cp->char_consumed);
+      cp->char_consumed = NULL;
+    }
+  InterlockedExchange (&cp->retired, 0);
+  return true;
+}
