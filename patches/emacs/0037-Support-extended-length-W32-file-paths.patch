+;;; w32-long-path-tests.el --- Private Win32 long-path regressions -*- lexical-binding: t; -*-
+
+;; This downstream test suite exercises actual built-in file operations.
+;; The optional native module provides an independent oracle and cleanup,
+;; including when testing an unpatched Emacs that cannot open the fixtures.
+
+(require 'ert)
+(require 'cl-lib)
+(require 'filenotify)
+
+(defconst w32-long-path-tests--payload "long-path-probe!\n")
+
+(when-let* ((module (getenv "EMACS_W32_LONG_PATH_MODULE")))
+  (module-load module))
+
+(defun w32-long-path-tests--units (path)
+  (/ (length (encode-coding-string path 'utf-16le t)) 2))
+
+(defun w32-long-path-tests--path (root units &optional component)
+  "Return a file under ROOT with exactly UNITS UTF-16 code units."
+  (let ((dir (file-name-as-directory root))
+        (component (or component (make-string 48 ?d))))
+    (while (> (- units (w32-long-path-tests--units dir)) 80)
+      (setq dir (concat dir component "/")))
+    (concat dir (make-string (- units (w32-long-path-tests--units dir) 4) ?f)
+            ".txt")))
+
+(defmacro w32-long-path-tests--with-root (&rest body)
+  (declare (indent 0))
+  `(progn
+     (skip-unless (eq system-type 'windows-nt))
+     (let ((root (make-temp-file "emacs-w32-long-path-" t))
+           (w32-unicode-filenames t))
+       (unwind-protect
+           (progn ,@body)
+         (when root
+           (if (fboundp 'w32-long-path-tests--native)
+               (should (= 0 (w32-long-path-tests--native "remove" root)))
+             (delete-directory root t)))))))
+
+(defun w32-long-path-tests--write (file &optional contents append)
+  (let ((coding-system-for-write 'no-conversion))
+    (write-region (or contents w32-long-path-tests--payload)
+                  nil file append 'silent)))
+
+(defun w32-long-path-tests--read (file)
+  (with-temp-buffer
+    (set-buffer-multibyte nil)
+    (insert-file-contents-literally file)
+    (buffer-string)))
+
+(ert-deftest w32-long-path-tests-native-262 ()
+  "The screenshot's failure, with an independently created 17-byte file."
+  (skip-unless (fboundp 'w32-long-path-tests--native))
+  (w32-long-path-tests--with-root
+    (let ((file (w32-long-path-tests--path root 262)))
+      (should (= 262 (w32-long-path-tests--native "units" file)))
+      (should (= 17 (w32-long-path-tests--native "write" file)))
+      (should (= 17 (w32-long-path-tests--native "size" file)))
+      (should (file-exists-p file))
+      (should (= 17 (file-attribute-size (file-attributes file))))
+      (should (equal w32-long-path-tests--payload
+                     (w32-long-path-tests--read file))))))
+
+(ert-deftest w32-long-path-tests-file-operations ()
+  "Read, write, stat, chmod, times, copy, replace, link and delete."
+  (w32-long-path-tests--with-root
+    (dolist (units '(247 248 255 259 260 261 262 263 1024 4096))
+      (let* ((file (w32-long-path-tests--path root units))
+             (dir (file-name-directory file))
+             (copy (concat file ".copy"))
+             (renamed (concat file ".renamed"))
+             (hard (concat file ".hard")))
+        (ert-info ((format "UTF-16 path length: %s" units))
+          (should (= units (w32-long-path-tests--units file)))
+          (make-directory dir t)
+          (w32-long-path-tests--write file)
+          (should (file-exists-p file))
+          (should (file-readable-p file))
+          (should (file-writable-p file))
+          (should (file-regular-p file))
+          (should (file-directory-p dir))
+          (should (file-accessible-directory-p dir))
+          ;; Exercise stat's by-handle path and both FindFirstFile paths.
+          (dolist (w32-get-true-file-attributes '(t nil local))
+            (should (= 17 (file-attribute-size (file-attributes file)))))
+          (should (equal w32-long-path-tests--payload
+                         (w32-long-path-tests--read file)))
+          (w32-long-path-tests--write file "append\n" t)
+          (should (= 24 (file-attribute-size (file-attributes file))))
+          (let ((time (encode-time '(1 2 3 4 5 2020))))
+            (set-file-times file time)
+            (should (time-equal-p time (file-attribute-modification-time
+                                       (file-attributes file)))))
+          (set-file-modes file #o444)
+          (should-not (file-writable-p file))
+          (set-file-modes file #o644)
+          (copy-file file copy nil t nil t)
+          (should (equal (file-modes file) (file-modes copy)))
+          (should (equal (w32-long-path-tests--read file)
+                         (w32-long-path-tests--read copy)))
+          (w32-long-path-tests--write renamed "replace me")
+          (rename-file copy renamed t)
+          (should-not (file-exists-p copy))
+          (should (equal (w32-long-path-tests--read file)
+                         (w32-long-path-tests--read renamed)))
+          (add-name-to-file file hard)
+          (should (file-equal-p file hard))
+          (delete-file hard)
+          (delete-file renamed)
+          (delete-file file)
+          (should-not (file-exists-p file))
+          ;; Explicit rmdir, not just fixture cleanup.
+          (let ((empty (expand-file-name "empty" dir)))
+            (make-directory empty)
+            (delete-directory empty)
+            (should-not (file-exists-p empty))))))))
+
+(ert-deftest w32-long-path-tests-unicode-and-directory ()
+  "UTF-8 bytes, UTF-16 units and Lisp characters are different counts."
+  (w32-long-path-tests--with-root
+    (let* ((file (w32-long-path-tests--path root 1500
+                                           (concat "目录-😀-" (make-string 24 ?文))))
+           (dir (file-name-directory file))
+           (other (expand-file-name "另一个-😀.txt" dir)))
+      (should (< (length file) (w32-long-path-tests--units file)))
+      (should (> (string-bytes (encode-coding-string file 'utf-8)) 1040))
+      (make-directory dir t)
+      (w32-long-path-tests--write file)
+      (w32-long-path-tests--write other)
+      (let ((default-directory dir))
+        (should (file-exists-p (file-name-nondirectory file)))
+        (should (equal w32-long-path-tests--payload
+                       (w32-long-path-tests--read "./另一个-😀.txt")))
+        (should (member "另一个-😀.txt" (directory-files ".")))
+        (let ((attrs (cdr (assoc "另一个-😀.txt"
+                                 (directory-files-and-attributes ".")))))
+          (should (= 17 (file-attribute-size attrs)))))
+      (should (equal (file-truename file) (file-truename (file-chase-links file))))
+      (should-not (string-match-p (regexp-quote "//?/") (file-truename file)))
+      (let ((newdir (concat (directory-file-name dir) "-renamed")))
+        (rename-file (directory-file-name dir) newdir)
+        (should (file-exists-p (expand-file-name "另一个-😀.txt" newdir)))))))
+
+(ert-deftest w32-long-path-tests-visit-save-backup ()
+  "Normal buffer visiting and saving must work, including backups."
+  (w32-long-path-tests--with-root
+    (dolist (backup-by-copying '(nil t))
+      (let* ((file (w32-long-path-tests--path root 1200))
+             (dir (file-name-directory file))
+             (backup-directory-alist nil)
+             (backup-enable-predicate (lambda (_) t))
+             (make-backup-files t)
+             (version-control 'never)
+             (buffer nil))
+        (make-directory dir t)
+        (w32-long-path-tests--write file)
+        (unwind-protect
+            (with-current-buffer (setq buffer (find-file-noselect file))
+              (should (verify-visited-file-modtime buffer))
+              (goto-char (point-max))
+              (insert "saved\n")
+              (save-buffer)
+              (should-not (buffer-modified-p))
+              (should (verify-visited-file-modtime buffer))
+              (should (equal (w32-long-path-tests--read file)
+                             (concat w32-long-path-tests--payload "saved\n")))
+              (should (equal w32-long-path-tests--payload
+                             (w32-long-path-tests--read (concat file "~")))))
+          (when (buffer-live-p buffer) (kill-buffer buffer)))))))
+
+(ert-deftest w32-long-path-tests-symlinks ()
+  "Keep relative targets relative; support absolute and directory links."
+  (w32-long-path-tests--with-root
+    (let ((probe (expand-file-name "privilege-probe" root)))
+      (condition-case err
+          (progn (make-symbolic-link "missing" probe) (delete-file probe))
+        (file-error
+         (message "Symlink permission probe: %S" err)
+         (ert-skip (format "Symlink permission unavailable: %S" err)))))
+    (let* ((file (w32-long-path-tests--path root 1300))
+           (dir (file-name-directory file))
+           (relative (expand-file-name "relative-link" dir))
+           (absolute (expand-file-name "absolute-link" root))
+           (directory (expand-file-name "directory-link" root))
+           (broken (expand-file-name "broken-link" dir))
+           (base (file-name-nondirectory file)))
+      (make-directory dir t)
+      (w32-long-path-tests--write file)
+      (make-symbolic-link base relative)
+      (should (equal base (file-symlink-p relative)))
+      (should (equal w32-long-path-tests--payload
+                     (w32-long-path-tests--read relative)))
+      (make-symbolic-link file absolute)
+      (should (equal file (file-symlink-p absolute)))
+      (should (file-equal-p file absolute))
+      (should (equal (file-truename file) (file-truename relative)))
+      (make-symbolic-link dir directory)
+      (should (file-directory-p directory))
+      (should (member base (directory-files directory)))
+      (make-symbolic-link "missing" broken)
+      (should-not (file-exists-p broken))
+      (should (equal "missing" (file-symlink-p broken)))
+      (dolist (link (list relative absolute directory broken))
+        (delete-file link))
+      (should (file-exists-p file)))))
+
+(ert-deftest w32-long-path-tests-notifications ()
+  "A native directory watch on a long path must deliver an actual event."
+  (skip-unless (eq system-type 'windows-nt))
+  (skip-unless (featurep 'w32notify))
+  (w32-long-path-tests--with-root
+    (let* ((file (w32-long-path-tests--path root 1400))
+           (dir (file-name-directory file))
+           (events nil)
+           (watch nil))
+      (make-directory dir t)
+      (unwind-protect
+          (progn
+            (setq watch (file-notify-add-watch dir '(change)
+                                               (lambda (event) (push event events))))
+            (should (file-notify-valid-p watch))
+            ;; Give the existing asynchronous watch thread time to arm.
+            (read-event nil nil 0.1)
+            (w32-long-path-tests--write file)
+            (let ((deadline (+ (float-time) 5))
+                  (matching (lambda (event)
+                              (and (memq (nth 1 event) '(created changed))
+                                   (equal (nth 2 event) file)))))
+              ;; Lock-file events can arrive first.  Wait for the actual
+              ;; file event, not merely for any notification at all.
+              (while (and (not (cl-some matching events))
+                          (< (float-time) deadline))
+                (read-event nil nil 0.05))
+              (should (cl-some matching events))))
+        (when watch (file-notify-rm-watch watch))))))
+
+(ert-deftest w32-long-path-tests-module-load ()
+  "LoadLibrary and module filenames must support a DLL in a long path."
+  (skip-unless (and (getenv "EMACS_W32_LONG_PATH_MODULE")
+                    (getenv "EMACS_W32_LONG_PATH_CLEANUP_FILE")))
+  (w32-long-path-tests--with-root
+    (let* ((dll (concat (w32-long-path-tests--path root 1250) ".dll")))
+      (make-directory (file-name-directory dll) t)
+      (copy-file (getenv "EMACS_W32_LONG_PATH_MODULE") dll)
+      (should (module-load dll))
+      ;; Windows retains loaded DLLs until process exit.  Record cleanup
+      ;; immediately, including when a subsequent assertion fails.
+      (write-region (concat root "\n") nil
+                    (getenv "EMACS_W32_LONG_PATH_CLEANUP_FILE") t 'silent)
+      (setq root nil)
+      (should (= 1254 (w32-long-path-tests--native "units" dll)))
+      (should (> (w32-long-path-tests--native "size" dll) 0)))))
+
+(ert-deftest w32-long-path-tests-invalid-and-ansi ()
+  "Over-limit and invalid inputs must fail without touching another file."
+  (w32-long-path-tests--with-root
+    (let* ((safe (expand-file-name "safe.txt" root))
+           (too-long (concat (file-name-as-directory root) (make-string 33000 ?a)))
+           (component (expand-file-name (make-string 256 ?b) root)))
+      (w32-long-path-tests--write safe)
+      (should-not (file-exists-p too-long))
+      ;; Invalid names cannot have lock files; keep this negative test
+      ;; from issuing a 33,000-character unlock warning.
+      (let ((create-lockfiles nil))
+        (should-error (w32-long-path-tests--write too-long) :type 'file-error))
+      (let ((enormous (concat (file-name-as-directory root)
+                              (make-string 140000 ?z))))
+        (should-not (file-exists-p enormous))
+        (should-error (make-directory enormous) :type 'file-error))
+      (should-error (make-directory component) :type 'file-error)
+      (should-error (w32-long-path-tests--write (concat safe "\0suffix"))
+                    :type 'wrong-type-argument)
+      (should (equal w32-long-path-tests--payload (w32-long-path-tests--read safe)))
+      (let* ((file (w32-long-path-tests--path root 1100)))
+        (make-directory (file-name-directory file) t)
+        (w32-long-path-tests--write file)
+        (let ((w32-unicode-filenames nil)
+              (create-lockfiles nil))
+          (should-not (file-exists-p file))
+          (should-error (w32-long-path-tests--write file) :type 'file-error))
+        (should (equal w32-long-path-tests--payload
+                       (w32-long-path-tests--read file)))))))
+
+(ert-deftest w32-long-path-tests-native-compilation ()
+  "Compile from and load an ELN in long paths, including external GCC I/O."
+  (skip-unless (and (native-comp-available-p)
+                    (getenv "EMACS_W32_LONG_PATH_CLEANUP_FILE")))
+  (w32-long-path-tests--with-root
+    (let* ((file (concat (w32-long-path-tests--path root 1150) ".el"))
+           (eln (concat file ".eln"))
+           (native-comp-async-report-warnings-errors 'silent))
+      (make-directory (file-name-directory file) t)
+      (w32-long-path-tests--write
+       file ";;; -*- lexical-binding: t; -*-\n(defun w32-long-path-tests--compiled (x) (+ x 7))\n")
+      ;; Loaded ELNs, like DLLs, remain mapped until process exit.
+      (write-region (concat root "\n") nil
+                    (getenv "EMACS_W32_LONG_PATH_CLEANUP_FILE") t 'silent)
+      (setq root nil)
+      (unwind-protect
+          (progn
+            (should (equal (native-compile file eln) eln))
+            (should (file-exists-p eln))
+            (load eln nil t)
+            (should (native-comp-function-p
+                     (symbol-function 'w32-long-path-tests--compiled)))
+            (should (= 28 (w32-long-path-tests--compiled 21))))
+        (fmakunbound 'w32-long-path-tests--compiled)))))
+
+(ert-deftest w32-long-path-tests-thumbnail ()
+  "GDI+ must read and write actual image files in long paths."
+  (skip-unless (fboundp 'w32image-create-thumbnail))
+  (w32-long-path-tests--with-root
+    (let* ((file (concat (w32-long-path-tests--path root 1350) ".png"))
+           (thumb (concat file ".thumb.png"))
+           (png (base64-decode-string
+                 "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAQAAAC1HAwCAAAAC0lEQVR42mP8/x8AAwMCAO+jCYkAAAAASUVORK5CYII=")))
+      (make-directory (file-name-directory file) t)
+      (w32-long-path-tests--write file png)
+      (should (w32image-create-thumbnail file thumb "png" 4 4))
+      (should (file-exists-p thumb))
+      (should (string-prefix-p (unibyte-string 137 80 78 71)
+                               (w32-long-path-tests--read thumb))))))
+
+(ert-deftest w32-long-path-tests-trash-fails-safely ()
+  "Legacy SHFileOperation cannot trash long paths; never delete instead."
+  (skip-unless (fboundp 'system-move-file-to-trash))
+  (w32-long-path-tests--with-root
+    (let ((file (w32-long-path-tests--path root 1000)))
+      (make-directory (file-name-directory file) t)
+      (w32-long-path-tests--write file)
+      (let ((modes (file-modes file)))
+        (should-error (system-move-file-to-trash file) :type 'file-error)
+        (should (equal modes (file-modes file))))
+      (should (equal w32-long-path-tests--payload
+                     (w32-long-path-tests--read file))))))
